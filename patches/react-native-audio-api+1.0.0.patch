+constexpr const char *PROC_FD_PREFIX = "/proc/self/fd/";
+
+// SAF grants access to the open descriptor, not to a path that can be reopened
+// through it. Reopening /proc/self/fd/<fd> can fail path-based access checks.
+int openSourceDescriptor(const std::string &filePath) {
+  if (filePath.rfind(PROC_FD_PREFIX, 0) == 0) {
+    const char *fdText = filePath.c_str() + std::strlen(PROC_FD_PREFIX);
+    char *end = nullptr;
+    const long parsedFd = std::strtol(fdText, &end, 10);
+    if (end != fdText && *end == '\0' && parsedFd >= 0) {
+      return ::dup(static_cast<int>(parsedFd));
+    }
+  }
+
+  return ::open(filePath.c_str(), O_RDONLY | O_CLOEXEC);
+}
